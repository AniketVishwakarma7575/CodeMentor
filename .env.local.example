# Copy to .env.local
#
# NEXT_PUBLIC_ is required — both values are read in client components
# (the SSE subscription and every mutation run in the browser).

NEXT_PUBLIC_API_BASE=http://localhost:3001/api/v1

# true  → render from src/data/ fixtures, no network. Design work, offline, demos.
# false → talk to the backend.
NEXT_PUBLIC_USE_FIXTURES=false
